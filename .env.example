# ==============================================================================
# Configurações da Stack WordPress - Biblioteca Carlos Benjamin de Lyra (IME-USP)
# Copie este arquivo para .env (local) ou cadastre as variáveis na Stack do Portainer
# ==============================================================================

# --- URL Principal do Ambiente ---
# Exemplos:
#   Local:       http://localhost:8080
#   Homologação: https://bib.dos.ime.usp.br
#   Produção:    https://bib.sistemas.ime.usp.br
#   Futuro DNS:  https://bib.ime.usp.br
WP_HOME=https://bib.sistemas.ime.usp.br
WP_SITEURL=

# --- Porta Exposta Localmente (Opcional quando usando Nginx Proxy Manager na rede 'web') ---
APP_PORT=8080

# --- Banco de Dados (MariaDB) ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=bib
WORDPRESS_DB_USER=bib
WORDPRESS_DB_PASSWORD=ALTERE_ESTA_SENHA_AQUI
MYSQL_ROOT_PASSWORD=ALTERE_A_SENHA_ROOT_AQUI
WORDPRESS_TABLE_PREFIX=wp_

# --- Usuário Admin do WordPress (Opcional: preencha WP_ADMIN_PASSWORD apenas se quiser redefinir a senha no boot) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=

# --- Debug e Performance ---
WORDPRESS_DEBUG=false
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M

